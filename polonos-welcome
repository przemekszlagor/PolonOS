else
    apt-get install -y -o DPkg::Lock::Timeout=60 build-essential dkms linux-image-amd64 linux-headers-amd64 "linux-headers-$(uname -r)" || true
    apt-get install -y -o DPkg::Lock::Timeout=60 -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" firmware-misc-nonfree firmware-nvidia-gsp nvidia-driver nvidia-smi nvidia-settings
fi
"""
            elif nvidia_choice == 'legacy_580':
                script_content += """
echo -e "${YELLOW}[*] Wykryto GPU Nvidia (RTX 50xx / Pascal / Maxwell). Przygotowywanie instalacji dedykowanych sterowników 580.xx...${NC}"

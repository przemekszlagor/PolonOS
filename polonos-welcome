    def launch_timeshift_gui(self):
        try:
            subprocess.Popen(["pkexec", "timeshift-gtk"])
        except Exception as e:
            QtWidgets.QMessageBox.warning(self, "Timeshift", f"Nie można uruchomić aplikacji Timeshift: {e}")

    def create_timeshift_snapshot(self):
        try:
            dialog = ProgressDialog("Tworzenie Migawki", "pkexec", ["timeshift", "--create", "--comments", "Migawka utworzona z PolonOS Welcome"], self)
            dialog.exec()
            QtWidgets.QMessageBox.information(self, "Sukces", "Migawka systemowa została utworzona pomyślnie!")
        except Exception as e:
            QtWidgets.QMessageBox.critical(self, "Błąd", f"Nie udało się utworzyć migawki: {e}")

    def enable_timeshift_auto(self):
        try:
            subprocess.run(["pkexec", "timeshift", "--schedule-daily"], check=False)
            self.lbl_timeshift_status.setText("• Harmonogram automatyczny: Codzienny (Włączony)")
            QtWidgets.QMessageBox.information(self, "Timeshift", "Automatyczne codzienne migawki zostały włączone.")
        except Exception as e:
            QtWidgets.QMessageBox.warning(self, "Błąd", f"Nie można włączyć automatycznych migawek: {e}")

    def disable_timeshift_auto(self):
        try:
            subprocess.run(["pkexec", "timeshift", "--schedule-none"], check=False)
            self.lbl_timeshift_status.setText("• Harmonogram automatyczny: Wyłączony")
            QtWidgets.QMessageBox.information(self, "Timeshift", "Automatyczne migawki zostały wyłączone.")
        except Exception as e:
            QtWidgets.QMessageBox.warning(self, "Błąd", f"Nie można wyłączyć automatycznych migawek: {e}")

    # --- AUTOSTART TRIGGER ---
    def on_autostart_toggled(self, checked):
        set_autostart_enabled(checked)


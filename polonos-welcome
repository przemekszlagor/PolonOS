    def install_selected_software(self):
        """Collects IDs and spawns ProgressDialog to run the install script graphically."""
        selected_apt = []
        selected_flatpak = []
        
        for app_id, (chk, app) in self.app_checkboxes.items():
            if chk.isChecked():
                if app.get("type") == "apt":
                    selected_apt.append(app_id)
                elif app.get("type") == "flatpak":
                    selected_flatpak.append(app_id)
                     
        if not selected_apt and not selected_flatpak:
            QtWidgets.QMessageBox.warning(self, "Brak zaznaczenia", "Proszę zaznaczyć przynajmniej jeden program do instalacji.")
            return
            
        cache_dir = os.path.expanduser("~/.cache/polonos-welcome")
        os.makedirs(cache_dir, exist_ok=True)
        script_path = os.path.join(cache_dir, "install_software.sh")
        
        # Formatting python arrays into bash arrays
        apt_array = " ".join([f'"{pkg}"' for pkg in selected_apt])
        flatpak_array = " ".join([f'"{pkg}"' for pkg in selected_flatpak])
        
        script_content = f"""#!/bin/bash
# PolonOS Software Installer Script

export DEBIAN_FRONTEND=noninteractive

RED='\\033[0;31m'
GREEN='\\033[0;32m'
YELLOW='\\033[1;33m'
BLUE='\\033[0;34m'
NC='\\033[0m'

echo -e "${{BLUE}}==================================================${{NC}}"
echo -e "${{BLUE}}        Instalacja Oprogramowania PolonOS         ${{NC}}"
echo -e "${{BLUE}}==================================================${{NC}}"
echo ""

APT_PACKAGES=({apt_array})
FLATPAK_PACKAGES=({flatpak_array})

# 1. Instalacja pakietów APT
if [ ${{#APT_PACKAGES[@]}} -gt 0 ]; then
    # Jesli instalujemy sagemath, przygotowanie zaleznosci oraz srodowiska virtualenv w /opt/sagemath
    if [[ " ${{APT_PACKAGES[*]}} " =~ " sagemath " ]]; then
        echo -e "${{YELLOW}}[*] Przygotowywanie środowiska matematycznego SageMath w /opt/sagemath...${{NC}}"
        apt-get install -y -o DPkg::Lock::Timeout=60 python3-pip python3-venv python3-dev cython3 pkg-config build-essential gfortran libgmp-dev libmpfr-dev libmpc-dev || true
        python3 -m venv /opt/sagemath
        /opt/sagemath/bin/pip install --upgrade pip setuptools wheel 2>/dev/null || true
        /opt/sagemath/bin/pip install sagemath 2>/dev/null || /opt/sagemath/bin/pip install sage 2>/dev/null || true
        ln -sf /opt/sagemath/bin/sage /usr/local/bin/sage 2>/dev/null || true
        ln -sf /opt/sagemath/bin/sage /usr/bin/sage 2>/dev/null || true
        ln -sf /opt/sagemath/bin/sagemath /usr/local/bin/sagemath 2>/dev/null || true
        ln -sf /opt/sagemath/bin/sagemath /usr/bin/sagemath 2>/dev/null || true
    fi

    # Jesli instalujemy wine, wlaczenie architektury i386, klucza GPG, repozytorium WineHQ i winetricks
    if [[ " ${{APT_PACKAGES[*]}} " =~ " winehq-stable " ]]; then
        if ! dpkg --print-foreign-architectures | grep -q "i386"; then
            echo -e "${{YELLOW}}[*] Włączanie architektury 32-bit (i386) dla Wine...${{NC}}"
            dpkg --add-architecture i386
        fi
        
        echo -e "${{YELLOW}}[*] Konfigurowanie klucza GPG oraz repozytorium WineHQ (Debian Trixie)...${{NC}}"
        mkdir -p /etc/apt/keyrings
        curl -fsSLo /etc/apt/keyrings/winehq-archive.key https://dl.winehq.org/wine-builds/winehq.key || wget -O /etc/apt/keyrings/winehq-archive.key https://dl.winehq.org/wine-builds/winehq.key
        curl -fsSLo /etc/apt/sources.list.d/winehq.sources https://dl.winehq.org/wine-builds/debian/dists/trixie/winehq-trixie.sources || wget -O /etc/apt/sources.list.d/winehq.sources https://dl.winehq.org/wine-builds/debian/dists/trixie/winehq-trixie.sources
        
        echo -e "${{YELLOW}}[*] Instalowanie menedżera skryptów Winetricks w /usr/local/bin/winetricks...${{NC}}"
        curl -fsSLo /usr/local/bin/winetricks https://raw.githubusercontent.com/Winetricks/winetricks/master/src/winetricks || wget -O /usr/local/bin/winetricks https://raw.githubusercontent.com/Winetricks/winetricks/master/src/winetricks
        chmod +x /usr/local/bin/winetricks 2>/dev/null || true
    fi

    echo -e "${{YELLOW}}Sprawdzanie i aktualizowanie list pakietów...${{NC}}"
    apt-get -o DPkg::Lock::Timeout=60 update
    UPDATE_STATUS=$?
    if [ $UPDATE_STATUS -ne 0 ]; then
        echo -e "${{YELLOW}}[!] Ostrzeżenie: Aktualizacja list pakietów nie powiodła się w pełni (kod: $UPDATE_STATUS).${{NC}}"
        echo -e "${{YELLOW}}    Upewnij się, że masz stabilne połączenie sieciowe.${{NC}}"
    fi

    echo -e "${{YELLOW}}Próba zbiorczej instalacji pakietów APT: ${{APT_PACKAGES[*]}}...${{NC}}"
    apt-get install -y -o DPkg::Lock::Timeout=60 -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" "${{APT_PACKAGES[@]}}"
    
    if [ $? -eq 0 ]; then
        echo -e "${{GREEN}}Pakiety APT zostały zainstalowane pomyślnie!${{NC}}"
    else
        echo -e "${{RED}}[!] Zbiorcza instalacja APT nie powiodła się. Przechodzenie do instalacji pojedynczej...${{NC}}"
        
        FAILED_APT=()
        for pkg in "${{APT_PACKAGES[@]}}"; do
            echo -e "${{YELLOW}}[*] Instalowanie pakietu: $pkg...${{NC}}"
            apt-get install -y -o DPkg::Lock::Timeout=60 -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" "$pkg"
            if [ $? -eq 0 ]; then
                echo -e "${{GREEN}}[+] Pakiet $pkg zainstalowany pomyślnie.${{NC}}"
            else
                echo -e "${{RED}}[-] Nie udało się zainstalować pakietu $pkg.${{NC}}"
                FAILED_APT+=("$pkg")
            fi
        done
    fi
fi

# 2. Instalacja pakietów Flatpak
if [ ${{#FLATPAK_PACKAGES[@]}} -gt 0 ]; then
    # Sprawdzenie czy flatpak jest zainstalowany
    if ! command -v flatpak &> /dev/null; then
        echo -e "${{YELLOW}}[*] Instalowanie menedżera Flatpak...${{NC}}"
        apt-get install -y -o DPkg::Lock::Timeout=60 flatpak
    fi

    # Dodanie repozytorium Flathub
    echo -e "${{YELLOW}}[*] Dodawanie repozytorium Flathub (system)...${{NC}}"
    flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

    # Instalacja pakietów Flatpak
    for pkg in "${{FLATPAK_PACKAGES[@]}}"; do
        echo -e "${{YELLOW}}[*] Instalowanie aplikacji Flatpak: $pkg...${{NC}}"
        flatpak install -y --system flathub "$pkg"
        if [ $? -eq 0 ]; then
            echo -e "${{GREEN}}[+] Aplikacja $pkg zainstalowana pomyślnie.${{NC}}"

            # Steam wymaga pakietu steam-devices (reguły udev dla kontrolerów/gamepadów)
            if [ "$pkg" = "com.valvesoftware.Steam" ]; then
                echo -e "${{YELLOW}}[*] Instalowanie pakietu systemowego steam-devices (reguły udev)...${{NC}}"
                apt-get install -y -o DPkg::Lock::Timeout=60 steam-devices 2>/dev/null
                if [ $? -eq 0 ]; then
                    echo -e "${{GREEN}}[+] Pakiet steam-devices zainstalowany — kontrolery będą działać poprawnie.${{NC}}"
                else
                    echo -e "${{YELLOW}}[!] Nie udało się zainstalować steam-devices. Kontrolery mogą wymagać ręcznej konfiguracji.${{NC}}"
                fi
            fi
        else
            echo -e "${{RED}}[-] Nie udało się zainstalować aplikacji $pkg.${{NC}}"
        fi
    done
fi

echo ""
echo -e "${{GREEN}}==================================================${{NC}}"
echo -e "${{GREEN}}      Proces instalacji zakończony!              ${{NC}}"
echo -e "${{GREEN}}==================================================${{NC}}"
echo ""
"""
        try:
            with open(script_path, "w", encoding="utf-8") as f:
                f.write(script_content)
            os.chmod(script_path, 0o755)
            
            # Execute script in graphical ProgressDialog using pkexec
            dialog = ProgressDialog("Instalacja Programów", "pkexec", ["bash", script_path], self)
            dialog.exec()
            
            # Mark successfully installed apps
            for app_id, (chk, app) in self.app_checkboxes.items():
                if chk.isChecked():
                    if is_app_installed(app_id, app.get("type", "apt")):
                        mark_app_as_installed(app_id)
            
            # Update statuses after installation completes
            self.update_software_statuses()
        except Exception as e:
            QtWidgets.QMessageBox.critical(self, "Błąd instalacji", f"Nie można wywołać instalatora: {e}")

    def uninstall_single_app(self, app):
        """Odinstalowuje pojedynczy program."""
        app_id = app["id"]
        app_name = app["name"]
        app_type = app.get("type", "apt")

        reply = QtWidgets.QMessageBox.question(
            self,
            "Potwierdzenie odinstalowania",
            f"Czy na pewno chcesz odinstalować program '{app_name}'?",
            QtWidgets.QMessageBox.StandardButton.Yes | QtWidgets.QMessageBox.StandardButton.No
        )
        if reply != QtWidgets.QMessageBox.StandardButton.Yes:
            return

        cache_dir = os.path.expanduser("~/.cache/polonos-welcome")
        os.makedirs(cache_dir, exist_ok=True)
        script_path = os.path.join(cache_dir, "uninstall_software.sh")

        if app_type == "apt":
            cmd = f"apt-get remove --purge -y {app_id}"
        else:
            cmd = f"flatpak uninstall -y --system {app_id}"

        script_content = f"""#!/bin/bash
export DEBIAN_FRONTEND=noninteractive
echo "Usuwanie programu {app_name}..."
{cmd}
echo "Usuwanie zakończone."
"""
        try:
            with open(script_path, "w", encoding="utf-8") as f:
                f.write(script_content)
            os.chmod(script_path, 0o755)

            dialog = ProgressDialog(f"Usuwanie {app_name}", "pkexec", ["bash", script_path], self)
            dialog.exec()

            mark_app_as_uninstalled(app_id)
            self.update_software_statuses()
        except Exception as e:
            QtWidgets.QMessageBox.critical(self, "Błąd usuwania", f"Nie można usunąć programu: {e}")

    def uninstall_selected_software(self):
        """Odinstalowuje zaznaczone zainstalowane programy."""
        selected_apt = []
        selected_flatpak = []

        for app_id, (chk, app) in self.app_checkboxes.items():
            if chk.isChecked() and is_app_installed(app_id, app.get("type", "apt")):
                if app.get("type") == "apt":
                    selected_apt.append(app_id)
                else:
                    selected_flatpak.append(app_id)

        if not selected_apt and not selected_flatpak:
            QtWidgets.QMessageBox.warning(self, "Brak zaznaczenia", "Proszę zaznaczyć przynajmniej jeden zainstalowany program do odinstalowania.")
            return

        reply = QtWidgets.QMessageBox.question(
            self,
            "Potwierdzenie odinstalowania",
            f"Czy na pewno chcesz odinstalować zaznaczone programy?\nLiczba programów do usunięcia: {len(selected_apt) + len(selected_flatpak)}",
            QtWidgets.QMessageBox.StandardButton.Yes | QtWidgets.QMessageBox.StandardButton.No
        )
        if reply != QtWidgets.QMessageBox.StandardButton.Yes:
            return

        cache_dir = os.path.expanduser("~/.cache/polonos-welcome")
        os.makedirs(cache_dir, exist_ok=True)
        script_path = os.path.join(cache_dir, "uninstall_software.sh")

        apt_array = " ".join([f'"{pkg}"' for pkg in selected_apt])
        flatpak_array = " ".join([f'"{pkg}"' for pkg in selected_flatpak])

        script_content = f"""#!/bin/bash
export DEBIAN_FRONTEND=noninteractive
echo "Rozpoczynanie usuwania zaznaczonych programów..."

if [ {len(selected_apt)} -gt 0 ]; then
    echo "Usuwanie pakietów systemowych APT..."
    apt-get remove --purge -y {apt_array}
fi

if [ {len(selected_flatpak)} -gt 0 ]; then
    echo "Usuwanie aplikacji Flatpak..."
    flatpak uninstall -y --system {flatpak_array}
fi
echo "Usuwanie zakończone pomyślnie."
"""
        try:
            with open(script_path, "w", encoding="utf-8") as f:
                f.write(script_content)
            os.chmod(script_path, 0o755)

            dialog = ProgressDialog("Usuwanie Programów", "pkexec", ["bash", script_path], self)
            dialog.exec()

            for app_id in selected_apt + selected_flatpak:
                mark_app_as_uninstalled(app_id)

            self.update_software_statuses()
        except Exception as e:
            QtWidgets.QMessageBox.critical(self, "Błąd usuwania", f"Nie można usunąć programów: {e}")


# --- CONFIGURATION & PATHS ---
AUTOSTART_DIR = os.path.expanduser("~/.config/autostart")
AUTOSTART_FILE = os.path.join(AUTOSTART_DIR, "polonos-welcome.desktop")
DISABLE_MARKER_FILE = os.path.expanduser("~/.config/polonos-welcome-autostart-disabled")
INSTALLED_MARKER_FILE = os.path.expanduser("~/.config/polonos-welcome-installed-apps")

def get_manually_installed_apps():
    """Zwraca listę ręcznie zainstalowanych programów z pliku konfiguracyjnego."""
    if not os.path.exists(INSTALLED_MARKER_FILE):
        return []
    try:
        with open(INSTALLED_MARKER_FILE, "r", encoding="utf-8") as f:
            return [line.strip() for line in f if line.strip()]
    except Exception:
        return []

def mark_app_as_installed(app_id):
    """Zapisuje program jako zainstalowany do pliku konfiguracyjnego."""
    try:
        os.makedirs(os.path.dirname(INSTALLED_MARKER_FILE), exist_ok=True)
        installed = get_manually_installed_apps()
        if app_id not in installed:
            installed.append(app_id)
            with open(INSTALLED_MARKER_FILE, "w", encoding="utf-8") as f:
                f.write("\n".join(installed))
    except Exception as e:
        print(f"Error marking app as installed: {e}")

def is_app_installed(app_id, app_type="apt"):
    """Sprawdza, czy program jest zainstalowany (poprzez plik konfiguracyjny, dpkg lub flatpak)."""
    # Sprawdzenie specyficzne dla SageMath zainstalowanego przez Condę
    if app_id == "sagemath":
        sage_path = os.path.expanduser("~/.miniconda3/envs/sage/bin/sage")
        if os.path.exists(sage_path):
            mark_app_as_installed(app_id)
            return True
        return False


    if app_id in ("wine", "winehq-staging"):
        if os.path.exists("/usr/bin/wine") or "wine" in get_manually_installed_apps() or "winehq-staging" in get_manually_installed_apps():
            mark_app_as_installed(app_id)
            return True
        try:
            res = subprocess.run(["dpkg-query", "-W", "-f=${Status}", "winehq-staging"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=2)
            if "install ok installed" in res.stdout:
                mark_app_as_installed(app_id)
                return True
        except Exception:
            pass

    # 1. Sprawdź plik konfiguracyjny
    if app_id in get_manually_installed_apps():
        return True
        
    # 2. Sprawdź flatpak lub dpkg
    if app_type == "flatpak":
        try:
            result = subprocess.run(
                ["flatpak", "info", app_id],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=2
            )
            if result.returncode == 0:
                mark_app_as_installed(app_id)
                return True
        except Exception:
            pass
    else:
        try:
            result = subprocess.run(
                ["dpkg-query", "-W", "-f=${Status}", app_id],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=2
            )
            if "install ok installed" in result.stdout:
                # Automatycznie dodaj do pliku konfiguracyjnego dla trwałości
                mark_app_as_installed(app_id)
                return True
        except Exception:
            pass
    return False

def get_network_info():
    """
    Zwraca tuple (connected, type_str, name_str) lub (False, None, None)
    type_str: 'przewodowe' (ethernet) lub 'bezprzewodowe' (wifi) lub inny
    name_str: nazwa sieci (SSID / nazwa połączenia)
    """
    try:
        # Uruchomienie nmcli z LANG=C w celu ujednolicenia formatu wyjściowego
        output = subprocess.check_output(
            "LANG=C nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device",
            shell=True,
            stderr=subprocess.DEVNULL
        ).decode("utf-8")
        
        for line in output.splitlines():
            line = line.strip()
            if not line:
                continue
            parts = line.split(":")
            if len(parts) >= 4:
                device, dev_type, state, connection = parts[0], parts[1], parts[2], parts[3]
                if state == "connected" and dev_type in ("wifi", "ethernet"):
                    type_str = "bezprzewodowe" if dev_type == "wifi" else "przewodowe"
                    return True, type_str, connection
    except Exception:
        pass
        
    # Alternatywna metoda sprawdzania połączenia przez gniazda (socket)
    try:
        socket.setdefaulttimeout(2)
        socket.socket(socket.AF_INET, socket.SOCK_STREAM).connect(("8.8.8.8", 53))
        return True, "przewodowe lub bezprzewodowe", "Aktywne połączenie"
    except Exception:
        pass
        
    return False, None, None


def get_asset_path(filename):
    """Próbuje znaleźć pliki graficzne w bieżącym katalogu, roboczym lub systemowym."""
    # 1. Katalog uruchomionego skryptu
    script_dir = os.path.dirname(os.path.abspath(__file__))
    path = os.path.join(script_dir, filename)
    if os.path.exists(path):
        return path
    # 2. Bieżący katalog roboczy
    path = os.path.join(os.getcwd(), filename)
    if os.path.exists(path):
        return path
    # 3. Systemowy katalog dystrybucji PolonOS
    path = os.path.join("/usr/share/polonos", filename)
    if os.path.exists(path):
        return path
    # 4. Systemowy katalog pixmaps
    path = os.path.join("/usr/share/pixmaps", filename)
    if os.path.exists(path):
        return path
    # 5. Dev paths relative to script dir (checking 2, 3 and 4 levels up for robustness)
    for levels_up in ("../../", "../../../", "../../../../"):
        for subdir in ("GRAPHIC/LOGO", "GRAPHIC/WALLPAPER", "GRAPHIC/Tapeta SVG"):
            path = os.path.abspath(os.path.join(script_dir, levels_up, subdir, filename))
            if os.path.exists(path):
                return path
    # 6. Dev paths relative to current working directory (checking 0, 1 and 2 levels up for robustness)
    for prefix in ("", "../", "../../"):
        for subdir in ("GRAPHIC/LOGO", "GRAPHIC/WALLPAPER", "GRAPHIC/Tapeta SVG"):
            path = os.path.abspath(os.path.join(os.getcwd(), prefix, subdir, filename))
            if os.path.exists(path):
                return path
    return None

def create_default_icons():
    """Generuje ikony w pamięci podręcznej użytkownika, jeśli nie ma plików lokalnych."""
    cache_dir = os.path.expanduser("~/.cache/polonos-welcome")
    os.makedirs(cache_dir, exist_ok=True)
    
    # 1. Ikona zaznaczenia (checkmark) dla checkboxów
    check_path = os.path.join(cache_dir, "check.png")
    if not os.path.exists(check_path):
        img = QtGui.QImage(16, 16, QtGui.QImage.Format.Format_ARGB32)
        img.fill(QtCore.Qt.GlobalColor.transparent)
        painter = QtGui.QPainter(img)
        painter.setRenderHint(QtGui.QPainter.RenderHint.Antialiasing)
        pen = QtGui.QPen(QColor(255, 255, 255), 2.5, QtCore.Qt.PenStyle.SolidLine, QtCore.Qt.PenCapStyle.RoundCap, QtCore.Qt.PenJoinStyle.RoundJoin)
        painter.setPen(pen)
        path = QtGui.QPainterPath()
        path.moveTo(3, 8)
        path.lineTo(7, 12)
        path.lineTo(13, 4)
        painter.drawPath(path)
        painter.end()
        img.save(check_path)
        
    return check_path

# --- AUTOSTART LOGIC ---
def is_autostart_enabled():
    if os.path.exists(DISABLE_MARKER_FILE):
        return False
    if os.path.exists(AUTOSTART_FILE):
        try:
            with open(AUTOSTART_FILE, "r", encoding="utf-8") as f:
                content = f.read()
                if "Hidden=true" in content:
                    return False
        except Exception:
            pass
    return True

def set_autostart_enabled(enabled):
    exec_path = "/usr/bin/polonos-welcome"
    if not os.path.exists(exec_path):
        exec_path = os.path.abspath(sys.argv[0])
        
    if enabled:
        # Remove disable marker if it exists
        if os.path.exists(DISABLE_MARKER_FILE):
            try:
                os.remove(DISABLE_MARKER_FILE)
            except Exception as e:
                print(f"Error removing disable marker: {e}")
                
        # Create autostart file
        os.makedirs(AUTOSTART_DIR, exist_ok=True)
        content = f"""[Desktop Entry]
Type=Application
Name=Witamy w PolonOS
Comment=Centrum konfiguracji poinstalacyjnej PolonOS
Exec={exec_path}
Icon=polonos-logo
Terminal=false
Categories=System;
X-KDE-autostart-after=panel
"""
        try:
            with open(AUTOSTART_FILE, "w", encoding="utf-8") as f:
                f.write(content)
            os.chmod(AUTOSTART_FILE, 0o755)
        except Exception as e:
            print(f"Error writing autostart file: {e}")
    else:
        # Create disable marker
        try:
            os.makedirs(os.path.dirname(DISABLE_MARKER_FILE), exist_ok=True)
            with open(DISABLE_MARKER_FILE, "w", encoding="utf-8") as f:
                f.write("disabled")
        except Exception as e:
            print(f"Error writing disable marker: {e}")
            
        # Write autostart file with Hidden=true to override the global template
        os.makedirs(AUTOSTART_DIR, exist_ok=True)
        content = f"""[Desktop Entry]
Type=Application
Name=Witamy w PolonOS
Comment=Centrum konfiguracji poinstalacyjnej PolonOS
Exec={exec_path}
Icon=polonos-logo
Terminal=false
Categories=System;
X-KDE-autostart-after=panel
Hidden=true
"""
        try:
            with open(AUTOSTART_FILE, "w", encoding="utf-8") as f:
                f.write(content)
            os.chmod(AUTOSTART_FILE, 0o755)
        except Exception as e:
            print(f"Error writing autostart file: {e}")

# --- SYSTEM INFORMATION GETTERS ---
def get_kernel():
    try:
        return subprocess.check_output(["uname", "-r"]).decode().strip()
    except:
        return "Nieznany"

def get_cpu():
    try:
        with open("/proc/cpuinfo", "r") as f:
            for line in f:
                if "model name" in line:
                    return re.sub(r".*:\s*", "", line).strip()
        return "Nieznany procesor"
    except:
        return "Nieznany"

def get_ram():
    try:
        with open("/proc/meminfo", "r") as f:
            for line in f:
                if "MemTotal" in line:
                    total_kb = int(re.findall(r"\d+", line)[0])
                    return f"{round(total_kb / 1024 / 1024, 1)} GB"
        return "Nieznana"
    except:
        return "Nieznana"

# --- HARDWARE CHECK BACKGROUND THREAD ---
class HardwareCheckThread(QThread):
    progress_signal = pyqtSignal(str)
    drivers_recommend_signal = pyqtSignal(list)
    finished_signal = pyqtSignal()
    
    def __init__(self):
        super().__init__()
        self.nvidia_stable_ver = None
        self.nvidia_latest_ver = None
        self.nvidia_pascal_maxwell = False
        
    def run(self):
        self.progress_signal.emit("=== ROZPOCZĘTO SKANOWANIE SPRZĘTU ===\n")
        self.sleep(1)
        
        # 1. Check network
        self.progress_signal.emit("[*] Sprawdzanie połączenia sieciowego...")
        network_ok = False
        try:
            # Try to resolve a host (Google DNS)
            socket.setdefaulttimeout(3)
            socket.socket(socket.AF_INET, socket.SOCK_STREAM).connect(("8.8.8.8", 53))
            network_ok = True
            self.progress_signal.emit("    Status: POŁĄCZONO Z INTERNETEM\n")
        except Exception:
            self.progress_signal.emit("    Status: BRAK POŁĄCZENIA (testy aktualizacji mogą być ograniczone)\n")
            
        self.sleep(1)
        
        # 2. Check GPU
        self.progress_signal.emit("[*] Wykrywanie karty graficznej (GPU)...")
        nvidia_detected = False
        self.nvidia_pascal_maxwell = False
        amd_detected = False
        gpu_info = ""
        try:
            lspci_gpu = subprocess.check_output("lspci | grep -i 'vga\\|3d'", shell=True).decode().strip()
            self.progress_signal.emit("    Wykryte urządzenia wideo:")
            for line in lspci_gpu.split("\n"):
                self.progress_signal.emit(f"    -> {line}")
                line_lower = line.lower()
                if "nvidia" in line_lower:
                    nvidia_detected = True
                    # Check for Maxwell / Pascal
                    chips = ["gp100", "gp102", "gp104", "gp106", "gp107", "gp108", 
                             "gm107", "gm108", "gm200", "gm204", "gm206"]
                    is_legacy_arch = False
                    for chip in chips:
                        if chip in line_lower:
                            is_legacy_arch = True
                            break
                    if not is_legacy_arch:
                        # Check marketing names
                        if "750 ti" in line_lower or "750ti" in line_lower:
                            is_legacy_arch = True
                        else:
                            for model in ["950", "960", "970", "980", "1030", "1050", "1060", "1070", "1080"]:
                                if model in line_lower:
                                    is_legacy_arch = True
                                    break
                            if not is_legacy_arch:
                                if re.search(r"gtx\s+9\d0", line_lower) or re.search(r"gtx\s+10\d0", line_lower):
                                    is_legacy_arch = True
                    
                    if is_legacy_arch:
                        self.nvidia_pascal_maxwell = True
                if "amd" in line_lower or "ati" in line_lower:
                    amd_detected = True
            gpu_info = lspci_gpu
        except Exception as e:
            self.progress_signal.emit("    Błąd wykrywania GPU: " + str(e))
            
        self.progress_signal.emit("")
        self.sleep(1)
        
        # 3. Check Network Interface (Wi-Fi)
        self.progress_signal.emit("[*] Wykrywanie kart sieciowych (Wi-Fi/Ethernet)...")
        broadcom_detected = False
        try:
            lspci_net = subprocess.check_output("lspci | grep -i 'network\\|wireless\\|ethernet'", shell=True).decode().strip()
            for line in lspci_net.split("\n"):
                self.progress_signal.emit(f"    -> {line}")
                if "broadcom" in line.lower():
                    broadcom_detected = True
        except Exception as e:
            self.progress_signal.emit("    Błąd wykrywania kart sieciowych: " + str(e))
            
        self.progress_signal.emit("")
        self.sleep(1)
        
        # 4. Check System Updates (Simulation dry-run)
        updates_count = 0
        if network_ok:
            self.progress_signal.emit("[*] Sprawdzanie dostępności aktualizacji systemowych...")
            try:
                # Run with LANG=C to avoid parsing localized text
                upgrade_check = subprocess.check_output("LANG=C apt-get -s upgrade", shell=True).decode()
                match = re.search(r"(\d+) upgraded", upgrade_check)
                if match:
                    updates_count = int(match.group(1))
                    self.progress_signal.emit(f"    Znaleziono: {updates_count} pakietów do aktualizacji.\n")
                else:
                    self.progress_signal.emit("    Brak oczekujących aktualizacji systemowych.\n")
            except Exception as e:
                self.progress_signal.emit("    Nie udało się sprawdzić aktualizacji: " + str(e) + "\n")
        else:
            self.progress_signal.emit("[*] Pominięto sprawdzanie aktualizacji (brak połączenia z siecią).\n")
            
        self.sleep(1)
        
        # Compile recommendations
        recommendations = []
        self.progress_signal.emit("=== WNIOSKI I REKOMENDACJE ===")
        
        if nvidia_detected:
            self.progress_signal.emit("[!] Wykryto kartę graficzną NVIDIA.")
            self.progress_signal.emit("    Zalecenie: Instalacja własnościowych sterowników NVIDIA dla optymalnej wydajności 3D.")
            self.progress_signal.emit("[*] Pobieranie informacji o wersjach sterowników NVIDIA...")
            
            # Query local candidate version (stable)
            try:
                output = subprocess.check_output(
                    "apt-cache policy nvidia-driver",
                    shell=True,
                    stderr=subprocess.DEVNULL
                ).decode("utf-8")
                for line in output.splitlines():
                    if "Candidate:" in line or "Kandydat:" in line:
                        candidate = line.split(":", 1)[1].strip()
                        if candidate and candidate != "(none)" and candidate != "(brak)":
                            self.nvidia_stable_ver = candidate.split("-")[0]
            except Exception:
                pass
                
            # Fallback: Parse local APT list files in system or relative to script dir
            if not self.nvidia_stable_ver:
                try:
                    script_dir = os.path.dirname(os.path.abspath(__file__))
                    paths_to_check = [
                        os.path.abspath(os.path.join(script_dir, "../../var/lib/apt/lists")),
                        "/var/lib/apt/lists"
                    ]
                    for lists_dir in paths_to_check:
                        if os.path.exists(lists_dir):
                            for filename in os.listdir(lists_dir):
                                if filename.endswith("Packages"):
                                    filepath = os.path.join(lists_dir, filename)
                                    with open(filepath, "r", encoding="utf-8", errors="ignore") as f:
                                        content = f.read()
                                        if "Package: nvidia-driver\n" in content:
                                            blocks = content.split("\n\n")
                                            for block in blocks:
                                                if "Package: nvidia-driver" in block:
                                                    version_match = re.search(r"^Version:\s*([^\s\n]+)", block, re.MULTILINE)
                                                    if version_match:
                                                        self.nvidia_stable_ver = version_match.group(1).split("-")[0]
                                                        break
                                            if self.nvidia_stable_ver:
                                                break
                        if self.nvidia_stable_ver:
                            break
                except Exception:
                    pass
                
            # Query latest version online
            if network_ok:
                try:
                    url = "https://developer.download.nvidia.com/compute/cuda/repos/debian13/x86_64/Packages"
                    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
                    with urllib.request.urlopen(req, timeout=5) as response:
                        content = response.read().decode('utf-8', errors='ignore')
                        versions = []
                        blocks = content.split('\n\n')
                        for block in blocks:
                            lines = block.split('\n')
                            is_target_pkg = False
                            for line in lines:
                                if line.strip() == 'Package: nvidia-driver':
                                    is_target_pkg = True
                                    break
                            if is_target_pkg:
                                version_match = re.search(r'^Version:\s*([^\s\n]+)', block, re.MULTILINE)
                                if version_match:
                                    versions.append(version_match.group(1).split('-')[0])
                        if versions:
                            def version_key(v):
                                try:
                                    return [int(x) for x in v.split('.')]
                                except Exception:
                                    return [0]
                            versions.sort(key=version_key)
                            self.nvidia_latest_ver = versions[-1]
                except Exception:
                    pass
            
            if self.nvidia_stable_ver:
                self.progress_signal.emit(f"    Dostępna wersja stabilna w systemie: {self.nvidia_stable_ver}")
            if self.nvidia_latest_ver:
                self.progress_signal.emit(f"    Dostępna najnowsza wersja online: {self.nvidia_latest_ver}")
                
            recommendations.append("nvidia")
        elif amd_detected:
            self.progress_signal.emit("[i] Wykryto kartę graficzną AMD/Radeon.")
            self.progress_signal.emit("    Zalecenie: Sprzęt działa na zintegrowanych sterownikach otwartych (Mesa). Instalacja nie jest wymagana.")
        else:
            self.progress_signal.emit("[i] Wykryto zintegrowaną grafikę Intel lub sterowniki standardowe.")
            self.progress_signal.emit("    Zalecenie: Sprzęt działa poprawnie. Opcjonalna aktualizacja firmware.")
            
        if broadcom_detected:
            self.progress_signal.emit("[!] Wykryto kartę Wi-Fi Broadcom.")
            self.progress_signal.emit("    Zalecenie: Instalacja pakietu 'bcmwl-kernel-source' w celu uruchomienia bezprzewodowej karty sieciowej.")
            recommendations.append("broadcom")
            
        if updates_count > 0:
            self.progress_signal.emit(f"[!] Dostępnych jest {updates_count} aktualizacji systemowych.")
            self.progress_signal.emit("    Zalecenie: Uruchomienie pełnej aktualizacji pakietów.")
            recommendations.append("updates")
            
        if not recommendations:
            self.progress_signal.emit("[OK] Twój sprzęt działa na optymalnych sterownikach otwartych.")
            self.progress_signal.emit("     Brak krytycznych rekomendacji do instalacji.")
            
        self.progress_signal.emit("\nSkanowanie zakończone pomyślnie.")
        self.drivers_recommend_signal.emit(recommendations)
        self.finished_signal.emit()

# --- CUSTOM SIDEBAR WIDGET WITH WALLPAPER BACKGROUND ---
class SidebarWidget(QFrame):
    def __init__(self, wallpaper_path, parent=None):
        super().__init__(parent)
        self.setObjectName("sidebar_container")
        self.wallpaper_path = wallpaper_path
        self.pixmap = None
        if wallpaper_path and os.path.exists(wallpaper_path):
            self.pixmap = QPixmap(wallpaper_path)
            
    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        
        if self.pixmap and not self.pixmap.isNull():
            # Scale and crop the wallpaper to fit the sidebar size
            scaled = self.pixmap.scaled(self.size(), Qt.AspectRatioMode.KeepAspectRatioByExpanding, Qt.TransformationMode.SmoothTransformation)
            x = (self.width() - scaled.width()) // 2
            y = (self.height() - scaled.height()) // 2
            painter.drawPixmap(x, y, scaled)
            
            # Semi-transparent dark overlay (frost effect overlay with 84% opacity)
            painter.fillRect(self.rect(), QColor(30, 30, 30, 215))
        else:
            # Fallback to dark elegant gradient
            gradient = QLinearGradient(0, 0, 0, self.height())
            gradient.setColorAt(0.0, QColor(30, 30, 30))
            gradient.setColorAt(1.0, QColor(22, 22, 22))
            painter.fillRect(self.rect(), gradient)
            
        # Draw border
        painter.setPen(QPen(QColor(45, 45, 45), 1))
        painter.drawLine(self.width() - 1, 0, self.width() - 1, self.height())


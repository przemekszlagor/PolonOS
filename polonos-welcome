    def get_theme_icon(self, names, fallback_pixmap=None):
        """Pobiera ikonę z motywu systemowego, wspierając listę nazw zapasowych."""
        for name in names:
            icon = QIcon.fromTheme(name)
            if not icon.isNull():
                return icon
        # Fallback to standard Qt icon if fallback_pixmap is specified
        if fallback_pixmap is not None:
            return QApplication.style().standardIcon(fallback_pixmap)
        return QIcon()

    def get_app_icon(self, names, app_name):
        """Próbuje pobrać ikonę z motywu lub ścieżek plikowych, a w razie braku generuje kolorowy awatarek z literą."""
        # 1. Local script icons directory
        script_dir = os.path.dirname(os.path.abspath(__file__))
        local_icons_dir = os.path.join(script_dir, "icons")
        
        # Check explicit file system icon locations
        search_dirs = [
            local_icons_dir,
            "/usr/lib/polonos-welcome/icons",
            "/usr/share/polonos-welcome/icons",
            "/usr/share/pixmaps",
            "/usr/share/icons/hicolor/64x64/apps",
            "/usr/share/icons/hicolor/48x48/apps",
            "/usr/share/icons/hicolor/scalable/apps",
            "/usr/share/icons/breeze-dark/apps/48",
            "/usr/share/icons/breeze-dark/categories/32",
            "/usr/share/icons/breeze/apps/48",
            "/usr/share/icons/breeze/categories/32",
            "/usr/share/icons/Mint-X/apps/48",
            "/usr/share/icons/Mint-X/categories/48",
            "/var/lib/flatpak/exports/share/icons/hicolor/64x64/apps",
            "/var/lib/flatpak/exports/share/icons/hicolor/scalable/apps",
            "/var/lib/swcatalog/icons/debian-forky-main/64x64"
        ]
        
        for name in names:
            for sdir in search_dirs:
                if not os.path.isdir(sdir):
                    continue
                for ext in [".png", ".svg", ".xpm"]:
                    path = os.path.join(sdir, f"{name}{ext}")
                    if os.path.isfile(path):
                        icon = QIcon(path)
                        if not icon.isNull():
                            pix = icon.pixmap(32, 32)
                            if not pix.isNull() and pix.width() > 0 and pix.height() > 0:
                                return icon

        # 2. System theme lookup
        for name in names:
            icon = QIcon.fromTheme(name)
            if not icon.isNull():
                pix = icon.pixmap(32, 32)
                if not pix.isNull() and pix.width() > 0 and pix.height() > 0:
                    return icon

        # 3. Fallback: Generowanie czytelnego, kolorowego awatara z literą
        app_color_map = {
            "Opera Browser": "#ff1b2d",
            "Pakiet Edukacyjny PolonOS (KDE Edu)": "#2563eb",
            "NVIDIA CUDA Toolkit": "#76b900",
            "Heroic Games Launcher": "#6366f1",
            "Pakiet Gier PolonOS (KDE Games)": "#f59e0b",
            "SageMath (System Matematyczny)": "#805ad5",
            "Wine Compatibility Layer & Winetricks": "#b91c1c",
            "Steam": "#00adff",
        }
        
        if app_name in app_color_map:
            bg_color = QColor(app_color_map[app_name])
        else:
            colors = [
                "#1abc9c", "#2ecc71", "#3498db", "#9b59b6", "#34495e",
                "#16a085", "#27ae60", "#2980b9", "#8e44ad", "#2c3e50",
                "#f1c40f", "#e67e22", "#e74c3c", "#f39c12", "#d35400",
                "#c0392b"
            ]
            color_idx = sum(ord(c) for c in app_name) % len(colors)
            bg_color = QColor(colors[color_idx])
        
        img = QtGui.QImage(32, 32, QtGui.QImage.Format.Format_ARGB32)
        img.fill(QtCore.Qt.GlobalColor.transparent)
        
        painter = QPainter(img)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        
        painter.setBrush(QBrush(bg_color))
        painter.setPen(QtCore.Qt.PenStyle.NoPen)
        painter.drawRoundedRect(0, 0, 32, 32, 6, 6)
        
        painter.setPen(QColor("#ffffff"))
        font = QFont("sans-serif", 14, QFont.Weight.Bold)
        painter.setFont(font)
        letter = app_name[0].upper() if app_name else "A"
        painter.drawText(img.rect(), Qt.AlignmentFlag.AlignCenter, letter)
        painter.end()
        
        return QIcon(QPixmap.fromImage(img))


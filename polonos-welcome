    def start_hardware_check(self):
        """Starts hardware scanning thread."""
        self.btn_check_drivers.setEnabled(False)
        self.btn_install_drivers.setEnabled(False)
        self.console_output.clear()
        self.progress_bar.setVisible(True)
        self.recommended_drivers = []
        
        self.check_thread = HardwareCheckThread()
        self.check_thread.progress_signal.connect(self.console_output.appendPlainText)
        self.check_thread.drivers_recommend_signal.connect(self.on_drivers_recommend_found)
        self.check_thread.finished_signal.connect(self.on_hardware_check_finished)
        self.check_thread.start()
        
    def on_drivers_recommend_found(self, recommendations):
        self.recommended_drivers = recommendations
        
    def on_hardware_check_finished(self):
        self.progress_bar.setVisible(False)
        self.btn_check_drivers.setEnabled(True)
        
        # Check if NVIDIA driver is recommended and prompt user
        if "nvidia" in self.recommended_drivers:
            stable_ver = getattr(self.check_thread, 'nvidia_stable_ver', None)
            latest_ver = getattr(self.check_thread, 'nvidia_latest_ver', None)
            is_legacy = getattr(self.check_thread, 'nvidia_pascal_maxwell', False)
            dialog = NvidiaDriverDialog(stable_ver, latest_ver, is_legacy, self)
            if dialog.exec() == QtWidgets.QDialog.DialogCode.Accepted:
                self.nvidia_choice = dialog.get_choice()
            else:
                self.nvidia_choice = "stable"
                
            if self.nvidia_choice == "latest":
                self.console_output.appendPlainText("\n[Wybór użytkownika] Wybrano instalację najnowszych sterowników NVIDIA z oficjalnego repozytorium producenta.")
            elif self.nvidia_choice == "legacy_580":
                self.console_output.appendPlainText("\n[Wybór użytkownika] Wybrano instalację dedykowanych sterowników NVIDIA 580.xx (LTS) dla architektury Pascal/Maxwell.")
            else:
                self.console_output.appendPlainText("\n[Wybór użytkownika] Wybrano instalację stabilnych sterowników NVIDIA z repozytorium dystrybucji.")
        
        # Enable installer button if we found NVIDIA, Broadcom drivers or Updates
        if self.recommended_drivers:
            self.btn_install_drivers.setEnabled(True)
        else:
            self.console_output.appendPlainText("\n[Informacja] Brak specyficznych pakietów do zainstalowania. Twój system jest aktualny i zoptymalizowany.")
            

                background-color: #121215;
                color: #34d399;
                font-family: 'Hack', 'Noto Mono', 'Courier New', monospace;
                font-size: 11px;
                border: 1px solid #2d2d2d;
                border-radius: 6px;
                padding: 8px;
            }
            QPushButton {
                background-color: #242424;
                color: #f4f4f5;
                border: 1px solid #2d2d2d;
                border-radius: 6px;
                padding: 8px 18px;
                font-size: 13px;
                font-weight: bold;
            }
            QPushButton:hover {
                background-color: #2d2d2d;
                border-color: #9b1b30;
            }
            QPushButton:disabled {
                background-color: #1e1e1e;
                color: #5e646d;
                border-color: #2d2d2d;
            }
        """)
        
        layout = QVBoxLayout(self)
        layout.setContentsMargins(20, 20, 20, 20)
        layout.setSpacing(15)
        
        self.lbl_status = QLabel("Przygotowanie do instalacji...")
        self.lbl_status.setStyleSheet("font-weight: bold; font-size: 14px; color: #c22e45;")
        layout.addWidget(self.lbl_status)
        
        self.progress_bar = QProgressBar()
        self.progress_bar.setRange(0, 0) # Indeterminate mode by default
        layout.addWidget(self.progress_bar)
        
        self.console = QPlainTextEdit()
        self.console.setReadOnly(True)
        layout.addWidget(self.console)
        
        self.btn_close = QPushButton("Zamknij")
        self.btn_close.setEnabled(False)
        self.btn_close.clicked.connect(self.accept)
        layout.addWidget(self.btn_close, alignment=Qt.AlignmentFlag.AlignRight)
        
        # QProcess setup
        self.process = QtCore.QProcess(self)
        self.process.readyReadStandardOutput.connect(self.on_stdout)
        self.process.readyReadStandardError.connect(self.on_stderr)
        self.process.finished.connect(self.on_finished)
        
        self.command = command
        self.args = args
        self.install_success = False
        
    def showEvent(self, event):
        super().showEvent(event)
        QtCore.QTimer.singleShot(100, self.start_install)
        
    def start_install(self):
        self.lbl_status.setText("Trwa autoryzacja i instalacja...")
        self.console.appendPlainText("[PolonOS] Uruchamianie procesu instalacji z uprawnieniami administratora...")
        self.process.start(self.command, self.args)
        
    def on_stdout(self):
        data = self.process.readAllStandardOutput().data().decode("utf-8", errors="replace")
        self.console.appendPlainText(data.strip())
        
        # Parse output line-by-line for status updates
        for line in data.splitlines():
            # Check for progress percentage in apt output if any
            # e.g., "Progress: [ 50%]"
            percent_match = re.search(r"Progress:\s*\[\s*(\d+)%\]", line)
            if percent_match:
                self.progress_bar.setRange(0, 100)
                self.progress_bar.setValue(int(percent_match.group(1)))
            elif "Unpacking" in line or "Rozpakowywanie" in line:
                pkg_match = re.search(r"(?:Unpacking|Rozpakowywanie)\s+([a-zA-Z0-9.\-_+:]+)", line)
                if pkg_match:
                    self.lbl_status.setText(f"Rozpakowywanie: {pkg_match.group(1)}...")
            elif "Setting up" in line or "Konfigurowanie" in line:
                pkg_match = re.search(r"(?:Setting up|Konfigurowanie)\s+([a-zA-Z0-9.\-_+:]+)", line)
                if pkg_match:
                    self.lbl_status.setText(f"Konfigurowanie: {pkg_match.group(1)}...")
                
    def on_stderr(self):
        data = self.process.readAllStandardError().data().decode("utf-8", errors="replace")
        self.console.appendPlainText(data.strip())
        
    def on_finished(self, exit_code, exit_status):
        self.progress_bar.setRange(0, 100)
        if exit_code == 0:
            self.progress_bar.setValue(100)
            self.lbl_status.setText("Instalacja zakończona pomyślnie!")
            self.console.appendPlainText("\n[PolonOS] Proces zakończony sukcesem.")
            self.install_success = True
        else:
            self.lbl_status.setText("Instalacja nie powiodła się.")
            if exit_code == 127:  # pkexec cancelled/dismissed
                self.console.appendPlainText("\n[PolonOS] Błąd: Anulowano autoryzację.")
            else:
                self.console.appendPlainText(f"\n[PolonOS] Błąd: Proces zakończył się kodem {exit_code}.")
        self.btn_close.setEnabled(True)



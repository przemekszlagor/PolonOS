BLUE='\\033[0;34m'
NC='\\033[0m'

echo -e "${BLUE}==================================================${NC}"
echo -e "${BLUE}        Instalacja Sterowników PolonOS            ${NC}"
echo -e "${BLUE}==================================================${NC}"
echo ""
"""

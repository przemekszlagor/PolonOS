    def get_theme_icon(self, names, fallback_pixmap=None):
        """Pobiera ikonę z motywu systemowego, wspierając listę nazw zapasowych."""
        for name in names:
            icon = QIcon.fromTheme(name)
            if not icon.isNull():
                return icon
        # Fallback to standard Qt icon if fallback_pixmap is specified
        if fallback_pixmap is not None:
            return QApplication.style().standardIcon(fallback_pixmap)
        return QIcon()

    def get_app_icon(self, names, app_name):
        """Próbuje pobrać ikonę aplikacji z motywu lub lokalnych zasobów, a w razie braku tworzy ładny awatar tekstowy."""
        # 1. Spróbuj z motywu systemowego
        for name in names:
            icon = QIcon.fromTheme(name)
            if not icon.isNull():
                return icon
                
        # 2. Spróbuj z lokalnych zasobów (pixmaps systemowe oraz folder deweloperski icons/)
        if getattr(sys, 'frozen', False):
            real_file = sys.executable
        else:
            real_file = os.path.realpath(__file__)
            
        script_dir = os.path.dirname(real_file)
        
        # Wykrywanie bazy chroota w ścieżce
        chroot_prefix = ""
        if "custom-root" in real_file:
            parts = real_file.split("custom-root")
            chroot_prefix = parts[0] + "custom-root"
            
        # Potencjalne katalogi na pixmaps
        pixmaps_dirs = ["/usr/share/pixmaps"]
        if chroot_prefix:
            pixmaps_dirs.append(os.path.join(chroot_prefix, "usr/share/pixmaps"))
            
        # Potencjalne katalogi na lokalne ikony deweloperskie
        local_icons_dirs = [
            os.path.join(script_dir, "icons"),
            os.path.join(os.path.dirname(script_dir), "icons")
        ]
        if "PolonOS-Repo" in real_file:
            repo_base = real_file.split("PolonOS-Repo")[0] + "PolonOS-Repo"
            local_icons_dirs.append(os.path.join(repo_base, "icons"))
            
        for name in names:
            # Uprość nazwę (np. com.opera.Opera -> opera)
            base_name = name.split(".")[-1].lower()
            for n in [name, base_name]:
                for ext in [".svg", ".png"]:
                    # Sprawdź w katalogach pixmaps
                    for pix_dir in pixmaps_dirs:
                        pix_path = os.path.join(pix_dir, n + ext)
                        if os.path.exists(pix_path):
                            return QIcon(pix_path)
                    # Sprawdź w lokalnych katalogach deweloperskich
                    for local_dir in local_icons_dirs:
                        local_path = os.path.join(local_dir, n + ext)
                        if os.path.exists(local_path):
                            return QIcon(local_path)
                
        # Fallback: Generowanie płaskiego, estetycznego awatara z pierwszą literą nazwy
        colors = [
            "#1abc9c", "#2ecc71", "#3498db", "#9b59b6", "#34495e",
            "#16a085", "#27ae60", "#2980b9", "#8e44ad", "#2c3e50",
            "#f1c40f", "#e67e22", "#e74c3c", "#f39c12", "#d35400",
            "#c0392b"
        ]
        # Prosty hash z nazwy aplikacji do wyboru koloru
        color_idx = sum(ord(c) for c in app_name) % len(colors)
        bg_color = QColor(colors[color_idx])
        
        img = QtGui.QImage(32, 32, QtGui.QImage.Format.Format_ARGB32)
        img.fill(QtCore.Qt.GlobalColor.transparent)
        
        painter = QPainter(img)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        
        # Rysowanie zaokrąglonego tła
        painter.setBrush(QBrush(bg_color))
        painter.setPen(QtCore.Qt.PenStyle.NoPen)
        painter.drawRoundedRect(0, 0, 32, 32, 6, 6)
        
        # Rysowanie litery
        painter.setPen(QColor("#ffffff"))
        font = QFont("sans-serif", 13, QFont.Weight.Bold)
        painter.setFont(font)
        letter = app_name[0].upper() if app_name else "A"
        painter.drawText(img.rect(), Qt.AlignmentFlag.AlignCenter, letter)
        painter.end()
        
        return QIcon(QPixmap.fromImage(img))


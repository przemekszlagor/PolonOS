[Icon Theme]
Name=PolonOS-Icons
Comment=Official PolonOS Icon Theme with PolonOS Emblem Launcher
DisplayDepth=32
Inherits=breeze-dark,breeze,hicolor
Example=folder

Directories=scalable/apps,scalable/categories,scalable/devices,scalable/places,scalable/status

[scalable/apps]
Size=128
Context=Applications
Type=Scalable
MinSize=16
MaxSize=512

[scalable/categories]
Size=128
Context=Categories
Type=Scalable
MinSize=16
MaxSize=512

[scalable/devices]
Size=128
Context=Devices
Type=Scalable
MinSize=16
MaxSize=512

[scalable/places]
Size=128
Context=Places
Type=Scalable
MinSize=16
MaxSize=512

[scalable/status]
Size=128
Context=Status
Type=Scalable
MinSize=16
MaxSize=512
